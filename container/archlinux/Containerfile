# Multiple redirections compete for stdout:
#  hadolint global ignore=SC2261
FROM ghcr.io/rdavid/goredoer:0.9.20260707 as goredoer
FROM archlinux:base
LABEL maintainer=David\ Rabkin\ <david@rabkin.co.il>
ENV \
	TIME_ZONE=Asia/Jerusalem \
	USER=shellbase
COPY LICENSES/* /licenses/
WORKDIR /bin
COPY --from=goredoer /goredo .
RUN \
	pacman-key --init \
	&& pacman --noconfirm --refresh --sync archlinux-keyring \
	&& pacman --noconfirm --refresh --sync --sysupgrade \
	&& pacman --noconfirm --sync \
		actionlint>=1.7 \
		asciidoctor>=2.0 \
		bash>=5.3 \
		dash>=0.5 \
		diffutils>=3.12 \
		fish>=4.8 \
		ksh>=2020.0 \
		perl \
		shellcheck>=0.11 \
		shfmt>=3.13 \
		tcsh>=6.24 \
		typos>=1.49 \
		vale>=3.17 \
		yamllint>=1.38 \
		zsh>=5.9 \
	&& ln -s /usr/bin/core_perl/shasum /usr/bin/shasum \
	&& useradd --create-home --uid 1001 "$USER" \
	&& cp /usr/share/zoneinfo/"$TIME_ZONE" /etc/localtime \
	&& printf %s "$TIME_ZONE" > /etc/timezone \
	&& goredo -symlinks
USER 1001
WORKDIR /home/"$USER"
COPY \
	--chown="$USER":"$USER" \
	. .
ENTRYPOINT [ "redo", "-j=10" ]
