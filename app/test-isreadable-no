#
# Verifies that isreadable fails when one of the given files is not
# readable. Root reads any file, so the script dies early when run as root.
#
# File not following:
#  shellcheck disable=SC1090
BSH="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"/../lib/base.sh
. "$BSH"
isroot && die Skip run as root.
fle1="$BASE_WIP/1"
fle2="$BASE_WIP/2"
touch "$fle1" "$fle2"
chmod a-r "$fle1"
ret=0
isreadable "$fle1" "$fle2" /tmp || ret=$?
rm "$fle1" "$fle2"
exit "$ret"
