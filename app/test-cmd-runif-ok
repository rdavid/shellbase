#
# Verifies that cmd_runif succeeds for an existing command and treats a
# missing command as a skipped no-op.
#
# File not following:
#  shellcheck disable=SC1090
BSH="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"/../lib/base.sh
. "$BSH"
cmd_runif : &&
	cmd_runif -q : &&
	cmd_runif printf '' &&
	cmd_runif c0mmand_n0t_f0und &&
	cmd_runif -q c0mmand_n0t_f0und
