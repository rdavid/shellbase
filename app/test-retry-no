#
# Verifies that retry fails for a zero, non-numeric, or missing attempt count,
# and for a command that keeps failing. A zero exit from any case ends the
# chain early and makes this -no script succeed. The harness flags that as a
# regression.
#
# File not following:
#  shellcheck disable=SC1090
BSH="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"/../lib/base.sh
. "$BSH"
retry -n 0 : ||
	retry -n foo : ||
	retry -n ||
	retry -n 2 false
