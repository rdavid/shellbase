#
# Verifies that var_exists rejects a variable name crafted to inject a
# command via unsafe expansion, without executing the injected command. An
# executed injection exits with zero. The harness expects a -no script to fail
# and flags that success.
#
# File not following:
#  shellcheck disable=SC1090
BSH="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"/../lib/base.sh
. "$BSH"
fle="$BASE_WIP/shellbase-injected-$$"
pay="PATH}\$(touch $fle)#"
ret=0
var_exists "$pay" || ret=$?
file_exists -q "$fle" && exit 0
exit "$ret"
